<Window x:Class="HanashGamingCafe.TransferWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="نقل الفاتورة إلى مكان آخر" Height="450" Width="400"
        WindowStartupLocation="CenterOwner" Background="#1E1E2C"
        FlowDirection="RightToLeft">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- عنوان النافذة -->
        <TextBlock Text="🚚 اختر المكان الجديد لنقل الفاتورة" 
                   Foreground="#FFCC00" FontSize="16" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <!-- قائمة الأجهزة والطاولات المتاحة -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ItemsAvailableDevices">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#2C2D3C" CornerRadius="8" Margin="0,0,0,8" Padding="12" Cursor="Hand"
                                MouseDown="DeviceCard_MouseDown">
                            <DockPanel>
                                <TextBlock Text="🟢 متاح" DockPanel.Dock="Left" Foreground="#2ECC71" FontWeight="Bold" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center" Margin="10,0">
                                    <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold" FontSize="14"/>
                                    <TextBlock Text="{Binding Type}" Foreground="#A0A0B0" FontSize="12"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- زر الإلغاء -->
        <Button Grid.Row="2" Content="إلغاء" Click="BtnCancel_Click" 
                Background="#E74C3C" Foreground="White" Height="35" Margin="0,15,0,0" 
                FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
    </Grid>
</Window>