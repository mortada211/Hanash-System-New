<Window x:Class="HanashGamingCafe.MenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="قائمة المشروبات والخدمات" Height="550" Width="800"
        WindowStartupLocation="CenterOwner" Background="#1E1E2C"
        FlowDirection="RightToLeft">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- الهيدر -->
        <TextBlock Text="🍹 اختر من المنيو لإضافته للفاتورة" 
                   Foreground="#FFCC00" FontSize="20" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <!-- أزرار التصنيفات (التبويبات) -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="HeaderTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="14" FontWeight="Bold" Foreground="White" Margin="10,5"/>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Background" Value="#2C2D3C"/>
                    <Setter Property="Padding" Value="10,5"/>
                </Style>
            </TabControl.Resources>

            <!-- 🥤 قسم العصائر -->
            <TabItem Header="🥤 العصائر والمشروبات الباردة">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0" PanningMode="Both">
                    <WrapPanel x:Name="PanelJuices" ItemWidth="140" ItemHeight="120" HorizontalAlignment="Right"/>
                </ScrollViewer>
            </TabItem>

            <!-- ☕ قسم المشروبات الساخنة -->
            <TabItem Header="☕ المشروبات الساخنة">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0" PanningMode="Both">
                    <WrapPanel x:Name="PanelHotDrinks" ItemWidth="140" ItemHeight="120" HorizontalAlignment="Right"/>
                </ScrollViewer>
            </TabItem>

            <!-- 💨 قسم الأراجيل -->
            <TabItem Header="💨 الأراجيل">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0" PanningMode="Both">
                    <WrapPanel x:Name="PanelShisha" ItemWidth="140" ItemHeight="120" HorizontalAlignment="Right"/>
                </ScrollViewer>
            </TabItem>

            <!-- 🍿 قسم التسالي والخدمات -->
            <TabItem Header="🍿 تسالي وخدمات">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0" PanningMode="Both">
                    <WrapPanel x:Name="PanelSnacks" ItemWidth="140" ItemHeight="120" HorizontalAlignment="Right"/>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- زر الإلغاء -->
        <Border Grid.Row="2" CornerRadius="5" Background="#E74C3C" HorizontalAlignment="Left" Margin="0,10,0,0" Width="120" Height="35">
            <Button Content="إغلاق" Click="BtnClose_Click" 
                    Background="Transparent" BorderThickness="0" Foreground="White" 
                    FontWeight="Bold" Cursor="Hand"/>
        </Border>
    </Grid>
</Window>