<Window x:Class="HanashGamingCafe.ShiftCloseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="جرد وتصفية الشفت" Height="500" Width="450"
        WindowStartupLocation="CenterOwner" Background="#1E1E2C"
        FlowDirection="RightToLeft" ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- الهيدر -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="📋 جرد الصندوق وتصفية الشفت" Foreground="#FFCC00" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock x:Name="TxtShiftInfo" Text="الشفت الحالي: مغلق" Foreground="#A0A0B0" FontSize="12" HorizontalAlignment="Center" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- محتوى الحسابات -->
        <Border Grid.Row="1" Background="#2C2D3C" CornerRadius="10" Padding="15">
            <StackPanel>
                <DockPanel Margin="0,0,0,10">
                    <TextBlock Text="اسم الكاشير:" Foreground="White" FontSize="14"/>
                    <TextBlock x:Name="TxtCashierName" Text="أحمد" Foreground="#3498DB" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right"/>
                </DockPanel>

                <DockPanel Margin="0,0,0,10">
                    <TextBlock Text="الخردة الافتتاحية:" Foreground="White" FontSize="14"/>
                    <TextBlock x:Name="TxtInitialCash" Text="0 د.ع" Foreground="White" FontSize="14" HorizontalAlignment="Right"/>
                </DockPanel>

                <DockPanel Margin="0,0,0,10">
                    <TextBlock Text="إجمالي مبيعات الشفت:" Foreground="White" FontSize="14"/>
                    <TextBlock x:Name="TxtTotalSales" Text="0 د.ع" Foreground="#2ECC71" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right"/>
                </DockPanel>

                <Separator Background="#3A3C52" Margin="0,5,0,15"/>
                <DockPanel Margin="0,0,0,10">
                    <TextBlock Text="المبلغ المتوقع بالصندوق:" Foreground="White" FontSize="14"/>
                    <TextBlock x:Name="TxtExpectedCash" Text="0 د.ع" Foreground="#F59E0B" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right"/>
                </DockPanel>
                <!-- إدخال المبلغ الفعلي -->
                <TextBlock Text="المبلغ النقد الفعلي بالصندوق (الدرج):" Foreground="#FFCC00" FontSize="13" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtActualCash" Height="38" Background="#1E1E2C" Foreground="White" FontSize="16" FontWeight="Bold" 
                         Padding="8,5" BorderBrush="#FFCC00" VerticalContentAlignment="Center" TextChanged="TxtActualCash_TextChanged"/>

                <!-- النتيجة والفرق -->
                <Border x:Name="BorderResult" Background="#1E1E2C" CornerRadius="6" Padding="10" Margin="0,15,0,0" Visibility="Collapsed">
                    <DockPanel>
                        <TextBlock x:Name="TxtResultLabel" Text="الفرق / العجز:" Foreground="White" FontSize="14" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtDifference" Text="0 د.ع" Foreground="White" FontSize="15" FontWeight="Bold" HorizontalAlignment="Right"/>
                    </DockPanel>
                </Border>

                <TextBlock Text="ملاحظات الجرد (إن وجدت):" Foreground="White" FontSize="12" Margin="0,15,0,5"/>
                <TextBox x:Name="TxtNotes" Height="45" Background="#1E1E2C" Foreground="White" TextWrapping="Wrap" AcceptsReturn="True" Padding="5"/>
            </StackPanel>
        </Border>

        <!-- الأزرار -->
        <Grid Grid.Row="2" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="🔒 إغلاق وتأكيد الجرد" Click="BtnConfirmCloseShift_Click" 
                    Background="#2ECC71" Foreground="White" FontWeight="Bold" Height="40" BorderThickness="0" Cursor="Hand"/>

            <Button Grid.Column="2" Content="إلغاء" Click="BtnCancel_Click" 
                    Background="#E74C3C" Foreground="White" FontWeight="Bold" Height="40" BorderThickness="0" Cursor="Hand"/>
        </Grid>
    </Grid>
</Window>