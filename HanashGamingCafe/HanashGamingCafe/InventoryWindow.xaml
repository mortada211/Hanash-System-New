<Window x:Class="HanashGamingCafe.InventoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إدارة المخزن والتوريد - قاعة ألعاب حنش الشهير" Height="650" Width="1000"
        WindowStartupLocation="CenterScreen" Background="#1E1E2C" FlowDirection="RightToLeft">
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- لوحة الإضافة والتوريد فقط -->
        <Border Grid.Column="0" Background="#2D2D44" CornerRadius="10" Padding="15" Margin="0,0,15,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="📦 إضافة / توريد كمية" Foreground="#00FF88" FontSize="18" FontWeight="Bold" Margin="0,0,0,15" HorizontalAlignment="Center"/>

                    <TextBlock Text="الباركود (اختياري):" Foreground="White" Margin="0,5,0,2"/>
                    <TextBox x:Name="TxtBarcode" Height="30" Background="#1E1E2C" Foreground="White" BorderBrush="#4E54C8" Padding="5" VerticalContentAlignment="Center"/>

                    <TextBlock Text="اسم المنتج:" Foreground="White" Margin="0,10,0,2"/>
                    <TextBox x:Name="TxtName" Height="30" Background="#1E1E2C" Foreground="White" BorderBrush="#4E54C8" Padding="5" VerticalContentAlignment="Center"/>

                    <TextBlock Text="التصنيف:" Foreground="White" Margin="0,10,0,2"/>
                    <ComboBox x:Name="CmbCategory" Height="30" Background="#1E1E2C" Foreground="Black" Padding="5">
                        <ComboBoxItem Content="مشروبات باردة" IsSelected="True"/>
                        <ComboBoxItem Content="مشروبات ساخنة"/>
                        <ComboBoxItem Content="شيشة ونرجيلة"/>
                        <ComboBoxItem Content="مأكولات خفيفة"/>
                        <ComboBoxItem Content="عام"/>
                    </ComboBox>

                    <TextBlock Text="وحدة القياس:" Foreground="White" Margin="0,10,0,2"/>
                    <ComboBox x:Name="CmbUnit" Height="30" Background="#1E1E2C" Foreground="Black" Padding="5">
                        <ComboBoxItem Content="قطعة" IsSelected="True"/>
                        <ComboBoxItem Content="فنجان"/>
                        <ComboBoxItem Content="كوب"/>
                        <ComboBoxItem Content="علبة"/>
                        <ComboBoxItem Content="كيلو"/>
                    </ComboBox>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="سعر الشراء:" Foreground="White" Margin="0,0,0,2"/>
                            <TextBox x:Name="TxtCostPrice" Text="0" Height="30" Background="#1E1E2C" Foreground="White" BorderBrush="#4E54C8" Padding="5" VerticalContentAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <TextBlock Text="سعر البيع:" Foreground="White" Margin="0,0,0,2"/>
                            <TextBox x:Name="TxtSellingPrice" Text="0" Height="30" Background="#1E1E2C" Foreground="White" BorderBrush="#4E54C8" Padding="5" VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="الكمية المضافة:" Foreground="#00FF88" FontWeight="Bold" Margin="0,0,0,2"/>
                            <TextBox x:Name="TxtStockQuantity" Text="1" Height="30" Background="#1E1E2C" Foreground="#00FF88" FontWeight="Bold" BorderBrush="#2ECC71" Padding="5" VerticalContentAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <TextBlock Text="حد التنبيه:" Foreground="White" Margin="0,0,0,2"/>
                            <TextBox x:Name="TxtMinStock" Text="5" Height="30" Background="#1E1E2C" Foreground="White" BorderBrush="#4E54C8" Padding="5" VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <Button Content="➕ إضافة / توريد للمخزن" Click="BtnAddStock_Click" Height="40" Background="#2ECC71" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,20,0,0" Cursor="Hand"/>
                    <Button Content="تفريغ الحقول 🔄" Click="BtnClear_Click" Height="30" Background="#7F8C8D" Foreground="White" BorderThickness="0" Margin="0,10,0,0" Cursor="Hand"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- جدول عرض المنتجات والبحث -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- شريط البحث -->
            <Border Grid.Row="0" Background="#2D2D44" CornerRadius="10" Padding="10" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtSearch" Height="35" Background="#1E1E2C" Foreground="White" BorderBrush="#4E54C8" Padding="8" VerticalContentAlignment="Center" TextChanged="TxtSearch_TextChanged" ToolTip="ابحث بالاسم أو الباركود..."/>
                    <Button Grid.Column="1" Content="تحديث القائمة 🔄" Click="BtnRefresh_Click" Padding="15,0" Background="#4E54C8" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="10,0,0,0" Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- جدول المنتجات -->
            <DataGrid x:Name="GridProducts" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" Background="#2B2C40" RowBackground="#1E1E2C" AlternatingRowBackground="#252538" Foreground="White" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#3A3B52" SelectionChanged="GridProducts_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="التصنيف" Binding="{Binding Category}" Width="110"/>
                    <DataGridTextColumn Header="الباركود" Binding="{Binding Barcode}" Width="100"/>
                    <DataGridTextColumn Header="وحدة القياس" Binding="{Binding Unit}" Width="90"/>
                    <DataGridTextColumn Header="سعر الشراء" Binding="{Binding CostPrice, StringFormat='{}{0:N0}'}" Width="90"/>
                    <DataGridTextColumn Header="سعر البيع" Binding="{Binding SellingPrice, StringFormat='{}{0:N0}'}" Width="90"/>
                    <DataGridTextColumn Header="المخزون الحالي" Binding="{Binding StockQuantity}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Window>