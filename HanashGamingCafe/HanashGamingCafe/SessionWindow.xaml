<Window x:Class="HanashGamingCafe.SessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إدارة الجلسة - قاعة ألعاب حنش الشهير" Height="500" Width="400"
        WindowStartupLocation="CenterOwner" Background="#1E1E2C" FlowDirection="RightToLeft">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- عنوان الطاولة -->
        <TextBlock x:Name="TxtDeviceName" Text="اسم الطاولة / الجهاز" Foreground="#FFCC00" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <!-- القسم الخاص بالجولات (للبليارد والطاولي) -->
        <Border x:Name="PanelGames" Grid.Row="1" Background="#2B2C40" CornerRadius="10" Padding="15" Margin="0,0,0,15">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="عدد الجولات الملعوبة" Foreground="#A0A0B0" FontSize="14" HorizontalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button Content="-" Width="40" Height="40" FontSize="20" FontWeight="Bold" Click="BtnMinusGame_Click" Background="#E74C3C" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                    <TextBlock x:Name="TxtGameCount" Text="0" Foreground="White" FontSize="28" FontWeight="Bold" Margin="20,0" VerticalAlignment="Center"/>
                    <Button Content="+" Width="40" Height="40" FontSize="20" FontWeight="Bold" Click="BtnPlusGame_Click" Background="#2ECC71" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- الإجمالي الحسابي -->
        <Border Grid.Row="2" Background="#2D2D44" CornerRadius="10" Padding="15" VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="الحساب الحالي الإجمالي" Foreground="#A0A0B0" FontSize="14" HorizontalAlignment="Center"/>
                <TextBlock x:Name="TxtTotalAmount" Text="0 د.ع" Foreground="#00FF88" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <!-- زر الإغلاق ودفع الحساب -->
        <Button Grid.Row="3" Content="إغلاق الجلسة وتحصيل الحساب 💳" Height="45" Background="#E74C3C" Foreground="White" FontSize="16" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnCloseSession_Click" Margin="0,15,0,0"/>
    </Grid>
</Window>