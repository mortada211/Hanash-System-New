<Window x:Class="HanashGamingCafe.ShiftsHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="سجل حركة الشفتات والتصفية" Height="680" Width="1100"
        WindowStartupLocation="CenterOwner" Background="#0F1016"
        FlowDirection="RightToLeft">

    <Window.Resources>
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Background" Value="#1E1F29"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2E303E"/>
            <Setter Property="Height" Value="36"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. الهيدر (العنوان الرئيسي) -->
        <Border Grid.Row="0" Background="#181924" CornerRadius="12" Padding="20,15" Margin="0,0,0,20">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Border Background="#2563EB" CornerRadius="10" Width="42" Height="42" Margin="0,0,12,0">
                        <TextBlock Text="📑" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="سجل حركة الشفتات وتصفية الصندوق" Foreground="White" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="متابعة عمليات فتح وإغلاق الشفتات والعجز والزيادة بدقة" Foreground="#8F92A1" FontSize="12" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. شريط الفلترة بالتواريخ -->
        <Border Grid.Row="1" Background="#181924" CornerRadius="12" Padding="16" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                    <TextBlock Text="📅 من تاريخ:" Foreground="#A0A3BD" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13" FontWeight="Medium"/>
                    <DatePicker x:Name="DpStartDate" Width="140"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,25,0">
                    <TextBlock Text="📅 إلى تاريخ:" Foreground="#A0A3BD" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13" FontWeight="Medium"/>
                    <DatePicker x:Name="DpEndDate" Width="140"/>
                </StackPanel>

                <Button Content="🔍 تطبيق الفلترة" Click="BtnFilter_Click" 
                        Style="{StaticResource ModernButtonStyle}" Background="#2563EB"/>
            </StackPanel>
        </Border>

        <!-- 3. جدول عرض الشفتات -->
        <Border Grid.Row="2" Background="#181924" CornerRadius="12" Padding="12">
            <DataGrid x:Name="DgShifts" AutoGenerateColumns="False" IsReadOnly="True"
                      Background="Transparent" RowBackground="#1F202C" AlternatingRowBackground="#181924"
                      Foreground="#E2E8F0" GridLinesVisibility="None" HeadersVisibility="Column"
                      RowHeight="42" FontSize="13" ColumnWidth="*" BorderThickness="0">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#252736"/>
                        <Setter Property="Foreground" Value="#94A3B8"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Height" Value="40"/>
                        <Setter Property="Padding" Value="10,0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}" BorderThickness="0" Padding="8,0">
                                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="معرف الشفت" Binding="{Binding Id}" Width="110"/>
                    <DataGridTextColumn Header="اسم الكاشير" Binding="{Binding CashierName}" Width="120"/>
                    <DataGridTextColumn Header="تاريخ الفتح" Binding="{Binding StartTime, StringFormat='{}{0:yyyy/MM/dd HH:mm}'}" Width="130"/>
                    <DataGridTextColumn Header="تاريخ الإغلاق" Binding="{Binding EndTime, StringFormat='{}{0:yyyy/MM/dd HH:mm}'}" Width="130"/>
                    <DataGridTextColumn Header="الخردة" Binding="{Binding InitialCash, StringFormat='{}{0:N0} د.ع'}" Width="100"/>
                    <DataGridTextColumn Header="المبيعات" Binding="{Binding TotalSales, StringFormat='{}{0:N0} د.ع'}" Width="100"/>
                    <DataGridTextColumn Header="الفعلي بالصندوق" Binding="{Binding ActualCash, StringFormat='{}{0:N0} د.ع'}" Width="110"/>
                    <DataGridTextColumn Header="العجز / الزيادة" Binding="{Binding Difference, StringFormat='{}{0:N0} د.ع'}" Width="110"/>
                    <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 4. الشريط السفلي والنتيجة النهائية -->
        <Grid Grid.Row="3" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="إغلاق النافذة" Click="BtnClose_Click" 
                    Style="{StaticResource ModernButtonStyle}" Background="#EF4444" Width="120"/>

            <Border Grid.Column="2" Background="#181924" CornerRadius="10" Padding="20,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="صافي العجز / الزيادة الكلي: " Foreground="#A0A3BD" FontSize="14" FontWeight="Medium" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtTotalDifference" Text="0 د.ع" Foreground="#F59E0B" FontSize="17" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>