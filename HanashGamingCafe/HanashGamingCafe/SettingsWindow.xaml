<Window x:Class="HanashGamingCafe.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إعدادات الفاتورة والطابعة" Height="250" Width="400" FlowDirection="RightToLeft" WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <StackPanel>
            <TextBlock Text="اسم القاعة (رأس الفاتورة):" Margin="0,5"/>
            <TextBox x:Name="TxtHallName" Height="30" VerticalContentAlignment="Center"/>

            <TextBlock Text="اختر الطابعة:" Margin="0,10,0,5"/>
            <ComboBox x:Name="CmbPrinters" Height="30" VerticalContentAlignment="Center"/>

            <Button Content="حفظ الإعدادات" Height="35" Margin="0,20,0,0" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>